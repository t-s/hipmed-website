<section class="hero-section">
  <div class="hero-content">
    <div class="hero-text">
      <h1>Healthcare Innovation for Underserved Areas</h1>
      <p>Hipmed provides software solutions that bridge the medical infrastructure gap in rural and underserved areas.</p>
      <div class="hero-buttons">
        <a href="/#mission" class="button primary">Our Mission</a>
        <a href="/#contact" class="button secondary">Get in Touch</a>
      </div>
    </div>
    <div class="hero-image">
      <img src="/img/hm-transparent.png" alt="Hipmed Logo" />
    </div>
  </div>
</section>

<section id="mission" class="section">
  <div class="card">
    <h2>Our Mission</h2>
    <p>At Hipmed, we are committed to developing innovative technology solutions that address the critical healthcare needs of underserved communities, particularly in rural areas lacking adequate medical infrastructure.</p>
    <p>We believe everyone deserves access to quality healthcare, regardless of their geographic location or economic status. Our mission is to create software tools that:</p>
    <ul>
      <li>Connect patients with healthcare providers through telemedicine</li>
      <li>Enable remote diagnosis and monitoring for chronic conditions</li>
      <li>Provide decision support systems for healthcare workers with limited resources</li>
      <li>Facilitate medical record keeping in low-connectivity environments</li>
      <li>Support community health education and preventive care initiatives</li>
    </ul>
    <p>By leveraging technology to overcome geographical and infrastructure barriers, we aim to improve health outcomes and quality of life for millions of people worldwide.</p>
  </div>
</section>

<section id="roadmap" class="section">
  <div class="card">
    <h2>Our Roadmap</h2>
    <div class="timeline">
      <div class="timeline-item">
        <div class="timeline-marker"></div>
        <div class="timeline-content">
          <h3>Phase 1: Research & Development</h3>
          <p>Conducting needs assessments in target communities, identifying key healthcare gaps, and developing prototype solutions tailored to specific regional challenges.</p>
        </div>
      </div>
      <div class="timeline-item">
        <div class="timeline-marker"></div>
        <div class="timeline-content">
          <h3>Phase 2: Pilot Programs</h3>
          <p>Launching initial pilot programs in selected communities to test our software solutions, gather feedback from users, and refine our approaches based on real-world implementation.</p>
        </div>
      </div>
      <div class="timeline-item">
        <div class="timeline-marker"></div>
        <div class="timeline-content">
          <h3>Phase 3: Scaling & Partnerships</h3>
          <p>Expanding our reach through strategic partnerships with healthcare organizations, NGOs, and government agencies to deploy our solutions more broadly and maximize impact.</p>
        </div>
      </div>
      <div class="timeline-item">
        <div class="timeline-marker"></div>
        <div class="timeline-content">
          <h3>Phase 4: Global Implementation</h3>
          <p>Adapting our technologies for diverse contexts worldwide and establishing a sustainable model for ongoing development, support, and expansion of our healthcare solutions.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<section id="contact" class="section">
  <div class="card">
    <h2>Contact Us</h2>
    <p>We'd love to hear from you! Whether you're interested in our solutions, want to partner with us, or simply have questions about our work, please don't hesitate to reach out.</p>
    
    <!-- 
    IMPORTANT: Website contact form
    -->
    <form action="https://getform.io/f/amdkwyrb" method="POST" class="contact-form" id="contact-form">
      <input type="hidden" name="_redirect" value="false">
      <input type="hidden" name="_subject" value="New Contact from HipMed Website">
      
      <div class="form-group">
        <label for="name">Name</label>
        <input type="text" id="name" name="name" required />
      </div>
      <div class="form-group">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" required />
      </div>
      <div class="form-group">
        <label for="subject">Subject</label>
        <input type="text" id="subject" name="subject" required />
      </div>
      <div class="form-group">
        <label for="message">Message</label>
        <textarea id="message" name="message" rows="5" required></textarea>
      </div>
      <div class="form-submit-area">
        <button type="submit" class="button" id="submit-btn">Send Message</button>
        <div class="or-email-directly">
          or email us directly at <a href="mailto:hello@hipmed.co">hello@hipmed.co</a>
        </div>
      </div>
    </form>
    
    <script>
      // Handle form submission with fetch to display toast notification
      document.addEventListener('DOMContentLoaded', function() {
        const form = document.getElementById('contact-form');
        const submitBtn = document.getElementById('submit-btn');
        
        if (form) {
          form.addEventListener('submit', async function(e) {
            e.preventDefault();
            
            if (submitBtn) {
              submitBtn.disabled = true;
              submitBtn.textContent = "Sending...";
            }
            
            try {
              const formData = new FormData(form);
              
              // Submit the form data
              const response = await fetch(form.action, {
                method: 'POST',
                body: formData,
                headers: {
                  'Accept': 'application/json',
                }
              });
              
              if (response.ok) {
                // Reset the form
                form.reset();
                
                // Show the toast notification
                const toast = document.getElementById('toast-notification');
                if (toast) {
                  toast.classList.add('show');
                  setTimeout(() => {
                    toast.classList.remove('show');
                  }, 5000);
                }
              } else {
                alert('There was a problem sending your message. Please try again or email us directly.');
              }
            } catch (error) {
              console.error('Error:', error);
              alert('There was a problem sending your message. Please try again or email us directly.');
            } finally {
              if (submitBtn) {
                submitBtn.disabled = false;
                submitBtn.textContent = "Send Message";
              }
            }
          });
        }
      });
    </script>
    
    <style>
      .form-submit-area {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 0.5rem;
      }
      
      .or-email-directly {
        font-size: 0.9rem;
        color: var(--text-light);
      }
    </style>
  </div>
</section>

<style>
  .hero-section {
    padding: 4rem 0;
  }

  .hero-content {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .hero-text {
    flex: 1;
  }

  .hero-text h1 {
    font-size: 2.5rem;
    margin-bottom: 1rem;
  }

  .hero-text p {
    font-size: 1.2rem;
    color: var(--text-light);
    margin-bottom: 2rem;
  }

  .hero-buttons {
    display: flex;
    gap: 1rem;
  }

  .button {
    display: inline-block;
  }

  .button.secondary {
    background-color: transparent;
    color: var(--accent-dark);
    border: 2px solid var(--accent);
  }

  .button.secondary:hover {
    background-color: var(--accent-light);
    color: var(--accent-dark);
  }

  .hero-image {
    flex: 1;
    display: flex;
    justify-content: center;
  }

  .hero-image img {
    max-width: 100%;
    height: auto;
    max-height: 300px;
  }

  .timeline {
    position: relative;
    margin: 2rem 0;
  }

  .timeline::before {
    content: '';
    position: absolute;
    top: 16px; /* Start from the middle of the first dot */
    height: calc(100% - 16px - 60px); /* Extended by a few pixels */
    left: 22px; /* Moved 2px to the right */
    width: 2px;
    background-color: var(--accent);
  }
  
  /* Add a specific style for the last timeline item */
  .timeline-item:last-child {
    margin-bottom: 0;
  }

  .timeline-item {
    position: relative;
    padding-left: 50px;
    margin-bottom: 2rem;
  }

  .timeline-marker {
    position: absolute;
    left: 12px; /* Moved 2px to the right */
    top: 6px;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background-color: var(--accent);
    border: 4px solid white;
  }

  .timeline-content h3 {
    margin-top: 0;
    margin-bottom: 0.5rem;
  }

  .contact-form {
    max-width: 600px;
    margin: 2rem auto 0;
  }

  .form-group {
    margin-bottom: 1.5rem;
  }

  .form-group label {
    display: block;
    margin-bottom: 0.5rem;
    font-weight: 500;
  }

  .form-group input,
  .form-group textarea {
    width: 100%;
    padding: 0.75rem;
    border: 1px solid #e2e8f0;
    border-radius: 4px;
    font-family: inherit;
  }

  .form-group input:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-light);
  }

  @media (max-width: 768px) {
    .hero-content {
      flex-direction: column-reverse;
      text-align: center;
    }

    .hero-buttons {
      justify-content: center;
    }

    .timeline::before {
      left: 17px; /* Moved 2px to the right */
    }

    .timeline-marker {
      left: 7px; /* Moved 2px to the right */
      width: 16px;
      height: 16px;
    }

    .timeline-item {
      padding-left: 40px;
    }
  }
</style>