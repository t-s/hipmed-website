---
---

<section class="hero-section">
  <div class="hero-content">
    <div class="hero-text">
      <h1>Healthcare Innovation for Underserved Areas</h1>
      <p>Hipmed provides software solutions that bridge the medical infrastructure gap in rural and underserved areas.</p>
      <div class="hero-buttons">
        <a href="/#mission" class="button primary">Our Mission</a>
        <a href="/#contact" class="button secondary">Get in Touch</a>
      </div>
    </div>
    <div class="hero-image">
      <img src="/img/hm-transparent.png" alt="Hipmed Logo" />
    </div>
  </div>
</section>

<section id="mission" class="section">
  <div class="card">
    <h2>Our Mission</h2>
    <p>At Hipmed, we are committed to developing innovative technology solutions that address the critical healthcare needs of underserved communities, particularly in rural areas lacking adequate medical infrastructure.</p>
    
    <div class="healthcare-pipeline">
      <div class="pipeline-container">
        <div class="pipeline-item" id="patient">
          <div class="pipeline-icon">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="var(--accent-dark)" width="36" height="36">
              <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
            </svg>
          </div>
          <div class="pipeline-label">Patient in Rural Area</div>
        </div>
        <div class="pipeline-arrow" id="arrow1">
          <svg class="arrow-right" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="var(--accent)" width="24" height="24">
            <path d="M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8-8-8z"/>
          </svg>
          <svg class="arrow-down" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="var(--accent)" width="24" height="24">
            <path d="M20 12l-1.41-1.41L13 16.17V4h-2v12.17l-5.58-5.59L4 12l8 8 8-8z"/>
          </svg>
        </div>
        <div class="pipeline-item" id="data">
          <div class="pipeline-icon">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="var(--accent-dark)" width="36" height="36">
              <path d="M17 1.01L7 1c-1.1 0-2 .9-2 2v18c0 1.1.9 2 2 2h10c1.1 0 2-.9 2-2V3c0-1.1-.9-1.99-2-1.99zM17 19H7V5h10v14zm-4.2-5.78v1.75l3.2-2.99L12.8 9v1.7c-3.11.43-4.35 2.56-4.8 4.7 1.11-1.5 2.58-2.18 4.8-2.18z"/>
            </svg>
          </div>
          <div class="pipeline-label">Field Data Collection</div>
        </div>
        <div class="pipeline-arrow" id="arrow2">
          <svg class="arrow-right" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="var(--accent)" width="24" height="24">
            <path d="M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8-8-8z"/>
          </svg>
          <svg class="arrow-down" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="var(--accent)" width="24" height="24">
            <path d="M20 12l-1.41-1.41L13 16.17V4h-2v12.17l-5.58-5.59L4 12l8 8 8-8z"/>
          </svg>
        </div>
        <div class="pipeline-item" id="care">
          <div class="pipeline-icon">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="var(--accent-dark)" width="36" height="36">
              <path d="M19 3H5c-1.1 0-1.99.9-1.99 2L3 19c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-1 11h-4v4h-4v-4H6v-4h4V6h4v4h4v4z"/>
            </svg>
          </div>
          <div class="pipeline-label">Localized Care</div>
        </div>
        <div class="pipeline-arrow" id="arrow3">
          <svg class="arrow-right" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="var(--accent)" width="24" height="24">
            <path d="M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8-8-8z"/>
          </svg>
          <svg class="arrow-down" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="var(--accent)" width="24" height="24">
            <path d="M20 12l-1.41-1.41L13 16.17V4h-2v12.17l-5.58-5.59L4 12l8 8 8-8z"/>
          </svg>
        </div>
        <div class="pipeline-item" id="health">
          <div class="pipeline-icon">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="var(--accent-dark)" width="36" height="36">
              <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
            </svg>
          </div>
          <div class="pipeline-label">Improved Health</div>
        </div>
      </div>
    </div>

    <p>We believe everyone deserves access to quality healthcare, regardless of their geographic location or economic status. Our mission is to create software tools that:</p>
    <ul>
      <li>Connect patients with healthcare providers through telemedicine</li>
      <li>Enable remote diagnosis and monitoring for chronic conditions</li>
      <li>Provide decision support systems for healthcare workers with limited resources</li>
      <li>Facilitate medical record keeping in low-connectivity environments</li>
      <li>Support community health education and preventive care initiatives</li>
    </ul>
    <p>By leveraging technology to overcome geographical and infrastructure barriers, we aim to improve health outcomes and quality of life for millions of people worldwide.</p>
  </div>
</section>

<section id="roadmap" class="section">
  <div class="card">
    <h2>Our Roadmap</h2>
    <div class="timeline">
      <div class="timeline-item">
        <div class="timeline-marker"></div>
        <div class="timeline-content">
          <h3>Phase 1: Research & Development</h3>
          <p>Conducting needs assessments in target communities, identifying key healthcare gaps, and developing prototype solutions tailored to specific regional challenges.</p>
        </div>
      </div>
      <div class="timeline-item">
        <div class="timeline-marker"></div>
        <div class="timeline-content">
          <h3>Phase 2: Pilot Programs</h3>
          <p>Launching initial pilot programs in selected communities to test our software solutions, gather feedback from users, and refine our approaches based on real-world implementation.</p>
        </div>
      </div>
      <div class="timeline-item">
        <div class="timeline-marker"></div>
        <div class="timeline-content">
          <h3>Phase 3: Scaling & Partnerships</h3>
          <p>Expanding our reach through strategic partnerships with healthcare organizations, NGOs, and government agencies to deploy our solutions more broadly and maximize impact.</p>
        </div>
      </div>
      <div class="timeline-item">
        <div class="timeline-marker"></div>
        <div class="timeline-content">
          <h3>Phase 4: Global Implementation</h3>
          <p>Adapting our technologies for diverse contexts worldwide and establishing a sustainable model for ongoing development, support, and expansion of our healthcare solutions.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<section id="contact" class="section">
  <div class="card">
    <h2>Contact Us</h2>
    <p>We'd love to hear from you! Whether you're interested in our solutions, want to partner with us, or simply have questions about our work, please don't hesitate to reach out.</p>
    
    <!-- 
    IMPORTANT: Website contact form
    -->
    <form action="https://getform.io/f/amdkwyrb" method="POST" class="contact-form" id="contact-form">
      <input type="hidden" name="_redirect" value="false">
      <input type="hidden" name="_subject" value="New Contact from HipMed Website">
      
      <div class="form-group">
        <label for="name">Name</label>
        <input type="text" id="name" name="name" required />
      </div>
      <div class="form-group">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" required />
      </div>
      <div class="form-group">
        <label for="subject">Subject</label>
        <input type="text" id="subject" name="subject" required />
      </div>
      <div class="form-group">
        <label for="message">Message</label>
        <textarea id="message" name="message" rows="5" required></textarea>
      </div>
      <div class="form-submit-area">
        <button type="submit" class="button" id="submit-btn">Send Message</button>
        <div class="or-email-directly">
          or email us directly at <a href="mailto:hello@hipmed.co">hello@hipmed.co</a>
        </div>
      </div>
    </form>
    
    <script>
      // Handle form submission with fetch to display toast notification
      document.addEventListener('DOMContentLoaded', function() {
        const form = document.getElementById('contact-form');
        const submitBtn = document.getElementById('submit-btn');
        
        if (form) {
          form.addEventListener('submit', async function(e) {
            e.preventDefault();
            
            if (submitBtn) {
              submitBtn.disabled = true;
              submitBtn.textContent = "Sending...";
            }
            
            try {
              const formData = new FormData(form);
              
              // Submit the form data
              const response = await fetch(form.action, {
                method: 'POST',
                body: formData,
                headers: {
                  'Accept': 'application/json',
                }
              });
              
              if (response.ok) {
                // Reset the form
                form.reset();
                
                // Show the toast notification
                const toast = document.getElementById('toast-notification');
                if (toast) {
                  toast.classList.add('show');
                  setTimeout(() => {
                    toast.classList.remove('show');
                  }, 5000);
                }
              } else {
                alert('There was a problem sending your message. Please try again or email us directly.');
              }
            } catch (error) {
              console.error('Error:', error);
              alert('There was a problem sending your message. Please try again or email us directly.');
            } finally {
              if (submitBtn) {
                submitBtn.disabled = false;
                submitBtn.textContent = "Send Message";
              }
            }
          });
        }
      });
    </script>
    
    <style>
      .form-submit-area {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 0.5rem;
      }
      
      .or-email-directly {
        font-size: 0.9rem;
        color: var(--text-light);
      }
    </style>
  </div>
</section>

<style>
  .hero-section {
    padding: 5rem 0 4rem;
  }

  .hero-content {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .hero-text {
    flex: 1;
  }

  .hero-text h1 {
    font-size: 3rem;
    margin-bottom: 1rem;
    font-family: var(--font-heading);
    line-height: 1.1;
  }

  .hero-text p {
    font-family: var(--font-body);
    font-size: 1.3rem;
    color: var(--text-light);
    margin-bottom: 2rem;
    line-height: 1.4;
    max-width: 40rem;
    font-weight: 400;
  }

  .hero-buttons {
    display: flex;
    gap: 1rem;
  }

  .button {
    display: inline-block;
  }

  .button.secondary {
    background-color: transparent;
    color: var(--accent-dark);
    border: 2px solid var(--accent);
  }

  .button.secondary:hover {
    background-color: var(--accent-light);
    color: var(--accent-dark);
  }

  .hero-image {
    flex: 1;
    display: flex;
    justify-content: center;
  }

  .hero-image img {
    max-width: 100%;
    height: auto;
    max-height: 300px;
  }

  /* Healthcare Pipeline Animation */
  .healthcare-pipeline {
    margin: 3rem 0;
    padding: 1rem;
    background-color: rgba(255, 255, 255, 0.6);
    border-radius: 12px;
  }

  .pipeline-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 900px;
    margin: 0 auto;
  }

  .pipeline-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 120px;
    opacity: 0;
    transform: translateY(20px);
  }

  .pipeline-icon {
    margin-bottom: 0.5rem;
    background-color: white;
    width: 80px;
    height: 80px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
    transition: transform 0.3s ease;
  }

  .pipeline-icon:hover {
    transform: scale(1.1);
  }

  .pipeline-label {
    text-align: center;
    font-weight: 500;
    font-size: 0.9rem;
    color: var(--accent-dark);
  }

  .pipeline-arrow {
    color: var(--accent);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .pipeline-arrow svg {
    opacity: 0;
    width: 24px;
    height: 24px;
  }
  
  .arrow-down {
    display: none;
  }
  
  .arrow-right {
    display: block;
  }

  /* Timeline styles */
  .timeline {
    position: relative;
    margin: 2rem 0;
  }

  .timeline::before {
    content: '';
    position: absolute;
    top: 16px; /* Start from the middle of the first dot */
    height: calc(100% - 16px - 60px); /* Extended by a few pixels */
    left: 22px; /* Moved 2px to the right */
    width: 2px;
    background-color: var(--accent);
  }
  
  /* Add a specific style for the last timeline item */
  .timeline-item:last-child {
    margin-bottom: 0;
  }

  .timeline-item {
    position: relative;
    padding-left: 50px;
    margin-bottom: 2rem;
  }

  .timeline-marker {
    position: absolute;
    left: 12px; /* Moved 2px to the right */
    top: 6px;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background-color: var(--accent);
    border: 4px solid white;
  }

  .timeline-content h3 {
    margin-top: 0;
    margin-bottom: 0.5rem;
  }

  .contact-form {
    max-width: 600px;
    margin: 2rem auto 0;
  }

  .form-group {
    margin-bottom: 1.5rem;
  }

  .form-group label {
    display: block;
    margin-bottom: 0.5rem;
    font-weight: 500;
  }

  .form-group input,
  .form-group textarea {
    width: 100%;
    padding: 0.75rem;
    border: 1px solid #e2e8f0;
    border-radius: 4px;
    font-family: inherit;
  }

  .form-group input:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-light);
  }

  @media (max-width: 768px) {
    .hero-content {
      flex-direction: column-reverse;
      text-align: center;
    }

    .hero-text h1 {
      font-size: 2.5rem;
    }
    
    .hero-text p {
      font-size: 1.2rem;
      margin-left: auto;
      margin-right: auto;
    }

    .hero-buttons {
      justify-content: center;
    }

    .timeline::before {
      left: 17px; /* Moved 2px to the right */
    }

    .timeline-marker {
      left: 7px; /* Moved 2px to the right */
      width: 16px;
      height: 16px;
    }

    .timeline-item {
      padding-left: 40px;
    }

    .pipeline-container {
      flex-direction: column;
      gap: 1rem;
    }

    .pipeline-arrow {
      margin: 0.5rem 0;
    }
    
    .arrow-right {
      display: none;
    }
    
    .arrow-down {
      display: block;
    }
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function() {
    // Wait for anime.js to load from CDN
    const script = document.createElement('script');
    script.src = 'https://cdnjs.cloudflare.com/ajax/libs/animejs/3.2.1/anime.min.js';
    script.onload = initAnimation;
    document.head.appendChild(script);
    
    function initAnimation() {
      // Healthcare pipeline animation
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            startAnimation();
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.2 });

      const pipeline = document.querySelector('.healthcare-pipeline');
      if (pipeline) {
        observer.observe(pipeline);
      }

      // Start animation immediately for demo purposes
      startAnimation();
      
      function startAnimation() {
      // Define the timeline
      const timeline = anime.timeline({
        easing: 'easeOutExpo',
        loop: true
      });

      // First stage: Patient appears
      timeline.add({
        targets: '#patient',
        opacity: [0, 1],
        translateY: [20, 0],
        duration: 800,
        delay: 300
      })
      
      // First arrow appears
      .add({
        targets: '#arrow1 svg',
        opacity: [0, 1],
        scale: [0.5, 1],
        duration: 400
      }, '-=200')
      
      // Second stage: Data collection appears
      .add({
        targets: '#data',
        opacity: [0, 1],
        translateY: [20, 0],
        duration: 800
      }, '-=200')
      
      // Second arrow appears
      .add({
        targets: '#arrow2 svg',
        opacity: [0, 1],
        scale: [0.5, 1],
        duration: 400
      }, '-=200')
      
      // Third stage: Care provision appears
      .add({
        targets: '#care',
        opacity: [0, 1],
        translateY: [20, 0],
        duration: 800
      }, '-=200')
      
      // Third arrow appears
      .add({
        targets: '#arrow3 svg',
        opacity: [0, 1],
        scale: [0.5, 1],
        duration: 400
      }, '-=200')
      
      // Fourth stage: Health improvement appears
      .add({
        targets: '#health',
        opacity: [0, 1],
        translateY: [20, 0],
        duration: 800
      }, '-=200')
      
      // Pause at the end to show the full pipeline
      .add({
        targets: '.pipeline-item, .pipeline-arrow svg',
        duration: 4000 // 4 second pause
      })
      
      // Reset all elements
      .add({
        targets: '.pipeline-item, .pipeline-arrow svg',
        opacity: 0,
        duration: 1000,
        easing: 'easeInExpo'
      });
      }
    }
  });
</script>